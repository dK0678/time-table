{
  "info": {
    "name": "Student Timetable & Goals API",
    "description": "ICT251 Activity 4 - Question 3. Set the baseUrl collection variable to your local or deployed server.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "id", "value": "1" }
  ],
  "item": [
    {
      "name": "GET all records",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/timetable", "host": ["{{baseUrl}}"], "path": ["api", "timetable"] }
      }
    },
    {
      "name": "GET one record",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/timetable/{{id}}", "host": ["{{baseUrl}}"], "path": ["api", "timetable", "{{id}}"] }
      }
    },
    {
      "name": "POST create record",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "if (json.id) { pm.collectionVariables.set('id', json.id); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"course_code\": \"CSC3101\",\n  \"course_name\": \"Artificial Intelligence\",\n  \"lecturer\": \"Dr. Kunda\",\n  \"day_of_week\": \"Saturday\",\n  \"start_time\": \"09:00\",\n  \"end_time\": \"11:00\",\n  \"venue\": \"Lecture Hall 2\",\n  \"goal\": \"Build a simple chatbot for the course project\",\n  \"goal_status\": \"Not Started\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/timetable", "host": ["{{baseUrl}}"], "path": ["api", "timetable"] }
      }
    },
    {
      "name": "PUT update record",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"course_code\": \"CSC3101\",\n  \"course_name\": \"Artificial Intelligence\",\n  \"lecturer\": \"Dr. Kunda\",\n  \"day_of_week\": \"Saturday\",\n  \"start_time\": \"09:00\",\n  \"end_time\": \"11:00\",\n  \"venue\": \"Lecture Hall 2\",\n  \"goal\": \"Build a simple chatbot for the course project\",\n  \"goal_status\": \"In Progress\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/timetable/{{id}}", "host": ["{{baseUrl}}"], "path": ["api", "timetable", "{{id}}"] }
      }
    },
    {
      "name": "DELETE record",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/timetable/{{id}}", "host": ["{{baseUrl}}"], "path": ["api", "timetable", "{{id}}"] }
      }
    }
  ]
}
